{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"declaration": true,
		"rootDir": "src",
		"outDir": "dist/esm",
		"skipLibCheck": false,
		"types": [],
		"lib": ["ES2022"],
		"newLine": "lf",

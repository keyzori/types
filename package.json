{
	"name": "@keyzori/types",
	"version": "0.2.0",
	"description": "Shared public HTTP types for Keyzori.",
	"license": "Apache-2.0",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/keyzori/types.git"
	},
	"main": "./dist/cjs/index.js",
	"module": "./dist/esm/index.js",
	"types": "./dist/esm/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/esm/index.d.ts",
				"default": "./dist/esm/index.js"
			},
			"require": {
				"types": "./dist/cjs/index.d.ts",
				"default": "./dist/cjs/index.js"
			}
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "node scripts/build.mjs",
		"typecheck": "tsc --noEmit",
		"test": "node --test tests/*.test.mjs",
		"lint": "biome check .",
		"check": "bun run build && bun run test && bun run lint",
		"prepack": "node scripts/build.mjs",
		"release:verify": "node scripts/verifyRelease.mjs",
		"audit": "bun audit --audit-level=high",
		"test:contract": "bunx --bun tsc -p tests/tsconfig.contract.json && bun test tests/routes.test.ts"
	},
	"devDependencies": {
		"typescript": "7.0.2",
		"@biomejs/biome": "2.5.12"
	}
}
